
meta
{
title: "Traffic Signs_ES";
version: '1.2025-03-23';
author: "yopaseopor";
icon: "ES/ES_.svg";
description: "Display all the signs included in OSM database for Spain. Specially recommended with roadsigns plugin and traffic_signs presets.";
    link: "https://wiki.openstreetmap.org/wiki/User:Yopaseopor#Advanced_real_place_traffic_signs_mapping";
/* Based on Speedlimit Signs from Martin Koppenhoefer. Code conversion from xml to mapcss by Xavier Barnada and Don-Vip. Tested by stoecker. Method of List of traffic signs by Lanxana.  Images from Wikimedia Commons and OSM Wiki  */
}
meta[lang=ca]
{
title: "Senyals Trànsit_ES";
description: "Mostra els senyals de trànsit introduits a OSM d'Espanya. Especialment recomanat amb el complement roadsigns i el preset Traffic_signs de JOSM.";
}
meta[lang=de]
{
title: "Verkehrszeichen_ES";
description: "Zeigt alle in OSM enthaltenen Verkehrszeichen an. Inbesondere zusammen mit dem RoadSigns-Plugin empfohlen.";
}
meta[lang=es]
{
title: "Señales Tráfico_ES";
description: "Muestra las señales de tráfico introducidas en OSM en toda España. Especialmente recomendado con el plugin roadsigns y preset Traffic_signs de JOSM.";
}

node["highway"="traffic_sign"]{
icon-offset-x:"0" ;
icon-offset-y:"0" ;
icon-width:"20" ;
icon-image:"ES/ES_real_place_highway.svg" ;
}

/*--pole--*/

node["man_made"="pole"]{
icon-offset-x:"0" ;
icon-offset-y:"0" ;
icon-width:"20" ;
icon-image:"ES/ES_man_made_pole.svg" ;
}


/*--traffic_sign--*/

