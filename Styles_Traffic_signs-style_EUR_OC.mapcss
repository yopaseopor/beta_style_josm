meta
{
	title: "Traffic Signs_EUR_OC";
	version: '1.2025-03-03';
	author: "yopaseopor";
	icon: "traffic_signs_EUR_OC/traffic_signs.png";
	description: "Display all the signs included in OSM database for West Europe (Austria, Andorra, Belgium, Switzerland, Czech Republic, Germany, Denmark, Spain, France, United Kingdom, Ireland, Italy, The Nederlands and Portugal, ). Specially recommended with roadsigns plugin and traffic_signs presets.";
    link: "https://wiki.openstreetmap.org/wiki/User:Yopaseopor#Advanced_real_place_traffic_signs_mapping";
	/* Based on Speedlimit Signs from Martin Koppenhoefer. Code conversion from xml to mapcss by Xavier Barnada and Don-Vip. Tested by stoecker. Method of List of traffic signs by Esther OSMCAT.  Images from Wikimedia Commons and OSM Wiki and own creation  */
}
meta[lang=ca]
{
title: "Senyals Trànsit_EUR_OC";
description: "Mostra els senyals de trànsit introduits a OSM a Europa.Especialment recomanat amb el complement roadsigns preset Espanya i el preset Traffic_signs de JOSM.";
}
meta[lang=de]
{
title: "Verkehrszeichen_EUR_OC";
description: "Zeigt alle in OSM enthaltenen Verkehrszeichen an. Inbesondere zusammen mit dem RoadSigns-Plugin empfohlen.";
}
meta[lang=es]
{
title: "Señales Tráfico_EUR_OC";
description: "Muestra las señales de tráfico introducidas en OSM en toda Europa.Especialmente recomendado con el plugin roadsigns preset España y preset Traffic_signs de JOSM.";
}

node["traffic_sign"="ES:ruta_europea"]{
icon-image:"traffic_signs_EUR_OC/ES/ES_ruta_europea.png" ;
}

*[maxspeed=100][direction=backward][side=both]{
icon-image:"traffic_signs_EUR_OC/ES/ES_R301_100.png";
}

node["highway"="milestone"]{
icon-image:"traffic_signs_EUR_OC/ES/ES_S573.png" ; 
}

node["highway"="traffic_sign"]{
icon-offset-x:"0" ;
icon-offset-y:"0" ;
icon-width:"20" ;
icon-image:"traffic_signs_EUR_OC/ES/ES_real_place_highway.svg" ;
}

/*--traffic_sign:2--*/

node["man_made"="pole"]{
icon-offset-x:"0" ;
icon-offset-y:"0" ;
icon-width:"20" ;
icon-image:"traffic_signs_EUR_OC/ES/ES_man_made_pole.svg" ;
}


/*--------------------------------------------------------------------------TEST------*/
/*---------------------------------------------------------------------------------*/

/*---------------------------------------------------------------------------------*/
node["traffic_sign"="A1"]{
icon-offset-x:"-2" ;
icon-width:"20" ;
icon-image:"traffic_signs_EUR_OC/CZ/CZ_A13.png" ; 
}





